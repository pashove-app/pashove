# PASHOVE — variables de production (Vercel)
# Ne jamais committer les vraies valeurs.

NEXT_PUBLIC_APP_URL="https://pashove.com"
NEXT_PUBLIC_APP_NAME="Pashove"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"

# Même projet Supabase que le local
NEXT_PUBLIC_SUPABASE_URL="https://gewibhqxizbzohbgnorh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[copier depuis .env.local]"
# ⚠️ Absent du .env.local actuel : à créer depuis Supabase → Settings → API
SUPABASE_SERVICE_ROLE_KEY="[service_role — serveur uniquement]"

# Brevo
BREVO_API_KEY="[copier depuis .env.local]"
EMAIL_DRIVER="brevo"
EMAIL_FROM="Pashove <noreply@pashove.com>"
EMAIL_REPLY_TO="support@pashove.com"

# Chiffrement — reprendre EXACTEMENT la valeur locale
ENCRYPTION_KEY="[copier depuis .env.local]"

# Cron
CRON_SECRET="[copier depuis .env.local ou nouvelle valeur aléatoire]"

# Cloudflare R2
R2_ENDPOINT="https://ce026d4ffb380492a8e9fea9ff91c79d.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="[copier depuis .env.local]"
R2_SECRET_ACCESS_KEY="[copier depuis .env.local]"
R2_BUCKET="pashove-files"
R2_PRIVATE_BUCKET="pashove-files-private"
R2_PUBLIC_URL="https://pub-4ef71a4ff50848b881fc86503a8fb29f.r2.dev"

# SasPay — clé de test pour l'instant
SASPAY_API_KEY="[copier depuis .env.local (sk_test_...)]"
SASPAY_WEBHOOK_SECRET="[copier depuis .env.local]"
SASPAY_MODE="sandbox"

# Recommandés avant ouverture publique
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# SENTRY_DSN=""

# Web Push (PWA livreur)
# Générer avec : node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY="[clé publique VAPID]"
VAPID_PRIVATE_KEY="[clé privée VAPID — serveur uniquement]"
