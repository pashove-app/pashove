# ============================================================
# PASHOVE — Variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# ⚠️ NE JAMAIS commiter .env.local
# ============================================================

# ---------- Application ----------
NEXT_PUBLIC_APP_URL="https://pashove.com"
NEXT_PUBLIC_APP_NAME="Pashove"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""          # ⚠️ serveur uniquement

# ---------- Upstash Redis (rate limit + idempotence) ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Cloudflare ----------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""               # DNS / R2 / Stream / Email Routing

# Cloudflare R2 (stockage fichiers)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="pashove-media"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL=""                      # pour les médias publics uniquement

# Cloudflare Stream (vidéos)
CLOUDFLARE_STREAM_API_TOKEN=""

# Cloudflare Turnstile (anti-bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Paiements ----------
# Flutterwave (socle : cartes + mobile money + sous-comptes/splits)
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_ENCRYPTION_KEY=""
FLW_WEBHOOK_SECRET_HASH=""

# CinetPay (mobile money UEMOA/CEMAC)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

# PayDunya (mobile money Sénégal)
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""

# Stripe (PHASE 2 — seulement si entité US)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------- E-mail ----------
# Resend — e-mails transactionnels (domaine: mail.pashove.com)
RESEND_API_KEY=""
EMAIL_FROM="Pashove <noreply@mail.pashove.com>"
EMAIL_REPLY_TO="support@pashove.com"

# Zoho Mail — boîtes humaines (module admin, Phase 5)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNT_ID=""

# ---------- SMS ----------
TERMII_API_KEY=""
TERMII_SENDER_ID="Pashove"

# ---------- KYC / identité ----------
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
SMILE_ENV="sandbox"                    # sandbox | production

# ---------- Monitoring ----------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ---------- Divers ----------
PAYOUT_PIN_PEPPER=""                   # sel serveur pour le hash du PIN de retrait
ENCRYPTION_KEY=""                      # chiffrement des données sensibles au repos
